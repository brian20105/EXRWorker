# Example .env file for local development
# Set DATABASE_URL to your Postgres connection string. Example format:
# postgres://username:password@hostname:5432/database_name
DATABASE_URL=postgres://username:password@localhost:5432/database_name

# Copy this file to .env and fill in real credentials before running the app.

# Discord bot/runtime
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Discord OAuth for website login
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:2000/api/auth/discord/callback

# Dashboard session signing secret
DASHBOARD_AUTH_SECRET=change_me_to_a_random_long_string
RUN_BOT=false

PORT=2000
NODE_ENV=development
